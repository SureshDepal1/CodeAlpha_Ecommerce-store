# Gmail account used by DepalNova to send email.
EMAIL_HOST_USER=your-email@gmail.com

# Create this at Google Account > Security > 2-Step Verification > App passwords.
# Use the generated App Password, not your normal Gmail password.
EMAIL_HOST_PASSWORD=PASTE_APP_PASSWORD_HERE

# Gmail normally uses TLS on port 587.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Use a name and address customers will see in the From field.
DEFAULT_FROM_EMAIL=DepalNova <your-email@gmail.com>

# Comma-separated owner addresses for new-order alerts.
ORDER_NOTIFICATION_EMAILS=owner@example.com

# Base URL used in customer and admin email links.
SITE_URL=http://127.0.0.1:8000

# If port 587 is blocked, use port 465 with SSL instead:
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
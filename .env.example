# Gmail account used by DepalNova to send email.
EMAIL_HOST_USER=your-email@gmail.com

# Create this at Google Account > Security > 2-Step Verification > App passwords.
# Use the generated App Password, not your normal Gmail password.
EMAIL_HOST_PASSWORD=PASTE_APP_PASSWORD_HERE

# Gmail normally uses TLS on port 587.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Use a name and address customers will see in the From field.
DEFAULT_FROM_EMAIL=DepalNova <your-email@gmail.com>

# Comma-separated owner addresses for new-order alerts.
ORDER_NOTIFICATION_EMAILS=owner@example.com

# Base URL used in customer and admin email links. Use the public https:// URL in production.
SITE_URL=http://127.0.0.1:8000

# Production deployment settings.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_DEPLOYMENT=False
DJANGO_BEHIND_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SSL_REDIRECT=
SERVE_MEDIA=
DATABASE_URL=
DJANGO_CACHE_BACKEND=locmem
# For multiple server processes, use DJANGO_CACHE_BACKEND=database and run:
# python manage.py createcachetable
STORE_NAME=DepalNova
STORE_CONTACT_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
RETURN_POLICY_SUMMARY=
DELIVERY_TIME_SUMMARY=
LEGAL_JURISDICTION=

# If port 587 is blocked, use port 465 with SSL instead:
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True